{
    "version": 2,
    "name": "kloud",
    "builds": [
      { "src": "api/*.js", "use": "@vercel/node" },
      { "src": "public/**/*", "use": "@vercel/static" }
    ],
    "routes": [
      { "src": "/api/debug", "dest": "/api/debug.js" },
      { "src": "/api/upload", "dest": "/api/upload.js" },
      { "src": "/api/download/(.*)", "dest": "/api/download.js?path=$1" },
      { "src": "/api/files", "dest": "/api/files.js" },
      { "src": "/api/folders", "dest": "/api/folders.js" },
      { "src": "/api/rename", "dest": "/api/rename.js" },
      { "src": "/api/items/(.*)", "dest": "/api/items.js?path=$1" },
      { "src": "/api/themes", "dest": "/api/themes.js" },
      { "src": "/api/themes/set", "dest": "/api/themes-set.js" },
      { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
      { "src": "/(.*)", "dest": "/public/$1" }
    ]
  }